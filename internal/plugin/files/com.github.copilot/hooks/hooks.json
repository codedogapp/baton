{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "\"$BATON_BIN\" hook guard"
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "\"$BATON_BIN\" hook stop"
      }
    ],
    "sessionStart": [
      {
        "type": "command",
        "bash": "\"$BATON_BIN\" hook session"
      }
    ]
  }
}
